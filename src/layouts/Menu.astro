---
const navItems = [
    { href: "/#whatido", no: "02", label: "Expertise" },
    { href: "/#skills", no: "03", label: "Stack" },
    { href: "/#experiences", no: "04", label: "Parcours" },
    { href: "/#projects", no: "05", label: "Projets" },
    { href: "/#contact", no: "06", label: "Contact" },
];
---

<header class="header-bar">
    <div class="shell flex items-center justify-between gap-4 py-3.5">
        <a href="/#home" class="grid leading-tight">
            <strong class="text-base font-semibold tracking-tight" style="color: var(--ink-strong);">
                Jordan Pantin
            </strong>
            <span class="mono-label hidden sm:block" style="text-transform: none; letter-spacing: 0.02em;">
                Lead tech .NET
            </span>
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Navigation principale">
            {
                navItems.map((item) => (
                    <a href={item.href} class="nav-link">
                        <span class="nav-no">{item.no}</span>{item.label}
                    </a>
                ))
            }
        </nav>

        <div class="hidden items-center md:flex">
            <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Changer de thème">
                Sombre
            </button>
        </div>

        <details class="relative md:hidden">
            <summary class="theme-toggle list-none marker:content-none">Menu</summary>
            <div class="menu-panel absolute right-0 mt-3 w-64">
                {
                    navItems.map((item) => (
                        <a href={item.href} class="menu-link">
                            <span class="nav-no" style="color: var(--accent); margin-right: 0.4em;">{item.no}</span>
                            {item.label}
                        </a>
                    ))
                }
                <button
                    id="theme-toggle-mobile"
                    type="button"
                    class="menu-link w-full cursor-pointer border-0 bg-transparent text-left"
                    aria-label="Changer de thème">
                    Thème sombre
                </button>
            </div>
        </details>
    </div>
</header>

<script is:inline>
    const storageKey = "theme";
    const root = document.documentElement;

    const setLabels = (theme) => {
        const next = theme === "dark" ? "Clair" : "Sombre";
        const desktop = document.getElementById("theme-toggle");
        const mobile = document.getElementById("theme-toggle-mobile");
        if (desktop) desktop.textContent = next;
        if (mobile) mobile.textContent = `Thème ${next.toLowerCase()}`;
    };

    setLabels(root.getAttribute("data-theme") === "dark" ? "dark" : "light");

    const bindToggle = (id) => {
        const button = document.getElementById(id);
        if (!button) return;

        button.addEventListener("click", () => {
            const current = root.getAttribute("data-theme") === "dark" ? "dark" : "light";
            const next = current === "dark" ? "light" : "dark";
            localStorage.setItem(storageKey, next);
            root.setAttribute("data-theme", next);
            setLabels(next);
        });
    };

    bindToggle("theme-toggle");
    bindToggle("theme-toggle-mobile");
</script>
