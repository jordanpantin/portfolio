import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
    title="Mission : Renfort Développeur Full Stack"
    reference="P-02 · BPCE IT"
    heading="Renfort full stack sur une application de communication et notification"
    lede="Application de communication et notification d'incidents informatiques pour BPCE IT, en équipe web et mobile."
    tags={[".NET", "MVC", "MAUI", "DevExpress", "BitBucket", "Jira"]}>
    <h2>Description</h2>
    <p>
        J'ai renforcé l'équipe existante en charge de l'application de
        communication et notification chez BPCE IT. En tant que développeur full
        stack polyvalent avec une expérience significative, j'ai contribué au
        développement d'applications web en .NET ainsi qu'aux applications
        mobiles.
    </p>
    <p>Équipe : 5 personnes (2 MOA + 3 DEV).</p>

    <h2>Tâches principales</h2>
    <ul>
        <li>
            <strong>Maintien en condition opérationnelle :</strong> exploitation,
            administration, support et dépannage de l'application existante.
        </li>
        <li>
            <strong>Renfort développement :</strong> participation aux étapes de
            développement des nouvelles fonctionnalités de l'application, web et
            mobile.
        </li>
        <li>
            <strong>Performance :</strong> optimisation des écrans les plus lents
            en revoyant le code Entity Framework existant — requêtes, projections
            et chargements — pour réduire les temps de réponse perçus en production.
        </li>
    </ul>
</ProjectLayout>
