---
export interface Props {
    github?: string;
    docker?: string;
    stackoverflow?: string;
    linkedin?: string;
}

const {
    github = "https://github.com/jordanpantin",
    docker = "https://hub.docker.com/u/jordanpantin",
    stackoverflow = "https://stackoverflow.com/users/7895727",
    linkedin = "https://www.linkedin.com/in/jordan-pantin",
} = Astro.props;

const links = [
    { href: linkedin, label: "LinkedIn" },
    { href: github, label: "GitHub" },
    { href: docker, label: "Docker Hub" },
    { href: stackoverflow, label: "Stack Overflow" },
];
---

<ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
    {
        links.map((link) => (
            <li>
                <a
                    class="nav-link"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer">
                    {link.label}
                    <span aria-hidden="true" style="color: var(--accent); margin-left: 0.3em;">↗</span>
                </a>
            </li>
        ))
    }
</ul>
