---
import { experiences } from "../../data/experiences";
import AnimatedCard from "../shared/AnimatedCard.astro";
---

<section class="doc-section" id="experiences">
    <div class="shell">
        <div class="doc-header">
            <span class="doc-no">04 — Parcours</span>
            <span class="doc-meta hidden sm:block">{experiences.length} postes · 2016 — aujourd'hui</span>
        </div>

        <div class="mb-12 max-w-3xl">
            <h2 class="section-title">
                Un parcours construit dans des contextes d'entreprise, au croisement
                de la production et de la structuration technique<span class="accent-dot">.</span>
            </h2>
        </div>

        <div class="ruled-list">
            {
                experiences.map((exp, index) => (
                    <AnimatedCard delay={index * 60}>
                        <article class="ruled-row">
                            <div>
                                <p class="mono-label m-0">{exp.year}</p>
                                <p class="muted-copy m-0 mt-2">
                                    {exp.company}
                                    <br />
                                    {exp.type}
                                </p>
                            </div>

                            <div>
                                <h3 class="row-title">{exp.title}</h3>
                                <p class="body-copy m-0 mt-2">{exp.description}</p>
                                <div class="tag-row mt-3">
                                    {exp.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                            </div>
                        </article>
                    </AnimatedCard>
                ))
            }
        </div>
    </div>
</section>
