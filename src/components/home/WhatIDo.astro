---
import { whatIDo } from "../../data/whatIDo";
import AnimatedCard from "../shared/AnimatedCard.astro";
---

<section class="doc-section" id="whatido">
    <div class="shell">
        <div class="doc-header">
            <span class="doc-no">02 — Expertise</span>
            <span class="doc-meta hidden sm:block">Cadrage · mise en œuvre · structuration</span>
        </div>

        <div class="mb-12 max-w-3xl">
            <h2 class="section-title">
                Des responsabilités techniques au service d'un produit,
                d'une équipe et d'un socle applicatif<span class="accent-dot">.</span>
            </h2>
        </div>

        <div class="ruled-list">
            {
                whatIDo.map((item, index) => (
                    <AnimatedCard delay={index * 60}>
                        <article class="ruled-row">
                            <div class="flex items-baseline gap-4">
                                <span class="idx">{String(index + 1).padStart(2, "0")}</span>
                                <h3 class="row-title">{item.title}</h3>
                            </div>

                            <div>
                                <p class="body-copy m-0">{item.description}</p>
                                <div class="tag-row mt-3">
                                    {item.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                            </div>
                        </article>
                    </AnimatedCard>
                ))
            }
        </div>
    </div>
</section>
