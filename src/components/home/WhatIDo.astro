---
import { whatIDo } from "../../data/whatIDo";
import AnimatedCard from "../shared/AnimatedCard.astro";
import { colorForTag } from "../../lib/tagColor";
---

<section class="py-24 bg-base-200" id="whatido">
    <div class="container mx-auto px-6">
        <h2 class="text-5xl font-bold text-center mb-16 text-primary">
            Mes compétences
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-7xl mx-auto">
            {
                whatIDo.map((item, index) => (
                    <AnimatedCard>
                        <div class="card bg-base-100 shadow-lg hover:shadow-2xl hover:-translate-y-2 hover:scale-105 transition-all duration-300 border border-base-300 rounded-2xl p-8">
                            <div class="flex flex-col items-center text-center">
                                <div class="p-5 bg-{item.color}/10 rounded-2xl flex items-center justify-center">
                                    <iconify-icon
                                        icon={item.icon}
                                        style="font-size: 64px;"
                                        class={`text-${item.color}`}
                                    />
                                </div>
                                <h3 class="text-2xl font-bold mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-base text-base-content/70 mb-6 leading-relaxed">
                                    {item.description}
                                </p>
                                <div class="flex flex-wrap gap-2 justify-center">
                                    {item.tags.map((tag) => (
                                        <span
                                            class={`badge badge-${colorForTag(tag)} badge-lg font-medium`}>
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </AnimatedCard>
                ))
            }
        </div>
    </div>
</section>
