---
import { projects } from "../../data/projects";
import AnimatedCard from "../shared/AnimatedCard.astro";

const [featuredProject, ...otherProjects] = projects;
---

<section class="doc-section" id="projects">
    <div class="shell">
        <div class="doc-header">
            <span class="doc-no">05 — Projets</span>
            <span class="doc-meta hidden sm:block">Sélection · simplification, migrations, arbitrages</span>
        </div>

        <div class="mb-12 max-w-3xl">
            <h2 class="section-title">
                Des exemples choisis pour montrer de la simplification,
                des migrations et des arbitrages concrets<span class="accent-dot">.</span>
            </h2>
        </div>

        {
            featuredProject && (
                <AnimatedCard>
                    <article class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
                        <figure class="doc-figure">
                            <img src={featuredProject.image} alt={featuredProject.title} loading="lazy" />
                            <figcaption>fig. 01 — aperçu du projet</figcaption>
                        </figure>

                        <div class="lg:pt-2">
                            <p class="idx m-0">P-01 · Projet mis en avant</p>
                            <h3 class="section-title mt-3" style="font-size: clamp(1.4rem, 2.4vw, 1.9rem);">
                                {featuredProject.title}
                            </h3>
                            <p class="body-copy mt-4">{featuredProject.client}</p>

                            <div class="tag-row mt-5">
                                {featuredProject.tags.map((tag) => (
                                    <span>{tag}</span>
                                ))}
                            </div>

                            {featuredProject.slug && (
                                <a href={`/projects/${featuredProject.slug}`} class="link-arrow mt-8 inline-flex">
                                    Lire le projet
                                    <span class="arrow" aria-hidden="true">→</span>
                                </a>
                            )}
                        </div>
                    </article>
                </AnimatedCard>
            )
        }

        <div class="ruled-list mt-14">
            {
                otherProjects.map((project, index) => (
                    <AnimatedCard delay={index * 60}>
                        <article class="ruled-row">
                            <div class="flex items-baseline gap-4">
                                <span class="idx">P-{String(index + 2).padStart(2, "0")}</span>
                                <h3 class="row-title">{project.title}</h3>
                            </div>

                            <div>
                                <p class="body-copy m-0">{project.client}</p>
                                <div class="tag-row mt-3">
                                    {project.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>

                                {project.slug && (
                                    <a href={`/projects/${project.slug}`} class="link-arrow mt-5 inline-flex text-sm">
                                        Ouvrir le détail
                                        <span class="arrow" aria-hidden="true">↗</span>
                                    </a>
                                )}
                            </div>
                        </article>
                    </AnimatedCard>
                ))
            }
        </div>
    </div>
</section>
