---
const contactPoints = [
    "Échange autour d'un poste de lead tech ou d'architecte applicatif",
    "Discussion sur un contexte d'équipe, de socle ou de refonte",
    "Prise de contact pour un poste salarié ou un entretien technique",
];
---

<section class="doc-section" id="contact">
    <div class="shell">
        <div class="doc-header">
            <span class="doc-no">06 — Contact</span>
            <span class="doc-meta hidden sm:block">Réponse humaine, pas de séquence automatisée</span>
        </div>

        <div class="grid gap-12 lg:grid-cols-[1fr_0.9fr] lg:gap-16">
            <div>
                <h2 class="section-title">
                    Si mon profil correspond à un poste de référent technique,
                    on peut échanger simplement<span class="accent-dot">.</span>
                </h2>

                <p class="body-copy mt-6">
                    Je suis particulièrement intéressé par les environnements où le
                    rôle ne se limite pas à produire du code, mais consiste aussi à
                    clarifier une direction technique, accompagner une équipe et faire
                    progresser le socle applicatif dans la durée.
                </p>

                <p class="muted-copy mt-4">
                    Si vous recrutez un lead tech ou un architecte applicatif, envoyez-moi
                    le contexte du poste, l'organisation de l'équipe et les enjeux
                    techniques. Je reviens vers vous avec une réponse claire.
                </p>

                <div class="ruled-list mt-8">
                    {
                        contactPoints.map((point, index) => (
                            <div class="grid grid-cols-[2.5rem_1fr] gap-3 border-b py-4" style="border-color: var(--hairline);">
                                <span class="idx">0{index + 1}</span>
                                <p class="body-copy m-0">{point}</p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <form id="contact-form" action="/api/contact" method="post" class="lg:pt-2">
                <p class="mono-label mb-6 border-b pb-3" style="border-color: var(--ink-strong); color: var(--ink-strong);">
                    Formulaire de prise de contact
                </p>

                <div class="grid gap-7">
                    <div>
                        <label for="contact-name" class="field-label">01 — Nom</label>
                        <input
                            name="name"
                            id="contact-name"
                            type="text"
                            placeholder="Votre nom"
                            class="field-input"
                            required
                        />
                    </div>

                    <div>
                        <label for="contact-email" class="field-label">02 — Email</label>
                        <input
                            name="email"
                            id="contact-email"
                            type="email"
                            placeholder="adresse@email.com"
                            class="field-input"
                            required
                        />
                    </div>

                    <div>
                        <label for="contact-message" class="field-label">03 — Message</label>
                        <textarea
                            name="message"
                            id="contact-message"
                            class="field-textarea"
                            placeholder="Contexte, rôle proposé, équipe, enjeux techniques…"
                            required></textarea>
                    </div>

                    <div class="flex flex-col items-start gap-3 pt-1">
                        <button id="contact-submit" class="btn btn-ink" type="submit">
                            Envoyer le message
                            <span aria-hidden="true">→</span>
                        </button>
                        <p id="contact-status" class="muted-copy m-0" role="status" aria-live="polite"></p>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<script type="module" is:inline>
    const form = document.getElementById("contact-form");
    const status = document.getElementById("contact-status");
    const submit = document.getElementById("contact-submit");

    if (form instanceof HTMLFormElement && status && submit instanceof HTMLButtonElement) {
        const submitLabel = submit.innerHTML;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            status.textContent = "";
            status.className = "muted-copy m-0";
            submit.disabled = true;
            submit.textContent = "Envoi en cours…";

            const nameInput = document.getElementById("contact-name");
            const emailInput = document.getElementById("contact-email");
            const messageInput = document.getElementById("contact-message");

            if (!(nameInput instanceof HTMLInputElement) || !(emailInput instanceof HTMLInputElement) || !(messageInput instanceof HTMLTextAreaElement)) {
                status.textContent = "Impossible de lire le formulaire.";
                status.className = "muted-copy m-0 status-error";
                submit.disabled = false;
                submit.innerHTML = submitLabel;
                return;
            }

            const name = nameInput.value;
            const email = emailInput.value;
            const message = messageInput.value;

            try {
                const res = await fetch("/api/contact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name, email, message }),
                });

                const json = await res.json();
                if (res.ok && json.ok) {
                    status.textContent = "Message envoyé, merci. Je reviens vers vous rapidement.";
                    status.className = "muted-copy m-0 status-success";
                    form.reset();
                } else {
                    status.textContent = json && json.error ? json.error : "Une erreur est survenue lors de l'envoi.";
                    status.className = "muted-copy m-0 status-error";
                }
            } catch {
                status.textContent = "Impossible de contacter le serveur.";
                status.className = "muted-copy m-0 status-error";
            } finally {
                submit.disabled = false;
                submit.innerHTML = submitLabel;
            }
        });
    }
</script>
