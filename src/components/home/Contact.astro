---

---

<section class="py-16 bg-base-200" id="contact">
    <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-8">Contactez‑moi</h2>
        <form
            id="contact-form"
            class="max-w-md mx-auto"
            action="/api/contact"
            method="post">
            <div class="form-control">
                <label for="contact-name" class="label mb-1">
                        <span class="label-text">Nom</span>
                </label>
                <input
                    name="name"
                    id="contact-name"
                    type="text"
                    placeholder="Votre nom"
                    class="input input-bordered w-full"
                    required
                />
            </div>

            <div class="form-control mt-3">
                <label for="contact-email" class="label mb-1">
                    <span class="label-text">Email</span>
                </label>
                <input
                    name="email"
                    id="contact-email"
                    type="email"
                    placeholder="Votre email"
                    class="input input-bordered w-full"
                    required
                />
            </div>

            <div class="form-control mt-3">
                <label class="label mb-1" for="contact-message">
                    <span class="label-text">Message</span>
                </label>
                <textarea
                    name="message"
                    id="contact-message"
                    class="textarea textarea-bordered h-24 w-full align-top"
                    placeholder="Votre message"
                    required></textarea>
            </div>
            <div class="form-control mt-6">
                <button
                    id="contact-submit"
                    class="btn btn-primary"
                    type="submit">Envoyer</button>
                <p id="contact-status" class="mt-3 text-center"></p>
            </div>
        </form>
    </div>
</section>

<script type="module">
    const form = document.getElementById("contact-form");
    const status = document.getElementById("contact-status");
    const submit = document.getElementById("contact-submit");

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            status.textContent = "";
            submit.disabled = true;
            submit.classList.add("loading");

            const name = document.getElementById("contact-name").value;
            const email = document.getElementById("contact-email").value;
            const message = document.getElementById("contact-message").value;

            try {
                const res = await fetch("/api/contact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name, email, message }),
                });

                const json = await res.json();
                if (res.ok && json.ok) {
                    status.textContent = "Message envoyé — merci !";
                    status.className = "mt-3 text-center text-success";
                    form.reset();
                } else {
                    status.textContent =
                        json && json.error
                            ? json.error
                            : "Une erreur est survenue lors de l'envoi.";
                    status.className = "mt-3 text-center text-error";
                }
            } catch (err) {
                status.textContent = "Impossible de contacter le serveur.";
                status.className = "mt-3 text-center text-error";
            } finally {
                submit.disabled = false;
                submit.classList.remove("loading");
            }
        });
    }
</script>
