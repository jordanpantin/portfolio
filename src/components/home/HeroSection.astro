---
const startYear = 2017;
const currentYear = new Date().getFullYear();
const yearsOfExperience = currentYear - startYear;

const interventions = [
    "Clarifier une direction technique quand le produit change d'échelle ou de rythme",
    "Remettre un socle applicatif sous contrôle avant qu'il freine la livraison",
    "Donner à l'équipe des repères de conception, de priorisation et d'exécution",
];

const cartouche = [
    { label: "Profil", value: "Lead tech .NET · Architecte applicatif" },
    { label: "Expérience", value: `${yearsOfExperience}+ ans — applications métier et produits internes` },
    { label: "Stack", value: ".NET · Angular · Azure" },
    { label: "Base", value: "Dijon, France" },
    { label: "Statut", value: "En poste — ouvert aux discussions" },
];
---

<section class="doc-section" id="home" style="padding-top: clamp(3rem, 6vw, 5rem);">
    <div class="shell">
        <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
            <div>
                <p class="mono-label mb-6">
                    <span style="color: var(--accent);">§01</span> — Jordan Pantin, référent technique
                </p>

                <h1 class="display-title">
                    Lead tech .NET<span class="accent-dot">.</span>
                </h1>

                <p class="lede mt-7">
                    J'aide des équipes à cadrer une direction technique, stabiliser
                    un socle applicatif et tenir une exécution plus lisible dans la durée.
                </p>

                <div class="mt-9 flex flex-wrap items-center gap-4">
                    <a href="#contact" class="btn btn-ink">
                        Échanger sur un poste
                        <span aria-hidden="true">→</span>
                    </a>
                    <a href="#projects" class="btn btn-ghost">Voir les projets</a>
                    <a
                        href="/CV_Jordan_PANTIN.pdf"
                        target="_blank"
                        rel="noreferrer"
                        class="link-arrow">
                        CV
                        <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                </div>

                <div class="mt-14">
                    <p class="mono-label mb-2">Types d'intervention</p>
                    <div class="ruled-list">
                        {
                            interventions.map((item, index) => (
                                <div class="grid grid-cols-[2.5rem_1fr] gap-3 border-b py-4" style="border-color: var(--hairline);">
                                    <span class="idx">0{index + 1}</span>
                                    <p class="body-copy m-0">{item}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <aside class="lg:pt-12">
                <div class="cartouche">
                    <p class="cartouche-caption m-0">Fiche d'identification</p>
                    <dl class="m-0">
                        {
                            cartouche.map((row) => (
                                <div class="cartouche-row">
                                    <dt>{row.label}</dt>
                                    <dd>{row.value}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>

                <p class="muted-copy mt-6">
                    Un profil de référent technique pour des environnements où il faut
                    arbitrer, simplifier et faire converger une équipe avec le produit.
                </p>
            </aside>
        </div>
    </div>
</section>
