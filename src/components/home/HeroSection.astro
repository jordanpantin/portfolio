---

---

<section
    class="hero min-h-screen bg-base-200 relative overflow-hidden"
    id="home">
    <!-- BACKGROUND -->
    <div
        class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-secondary/20">
    </div>

    <div class="hero-content text-center relative z-10 px-6">
        <div class="max-w-4xl">
            <!-- Title -->
            <h1 class="text-5xl md:text-7xl font-bold text-primary mb-6">
                Bonjour, je suis <span class="text-secondary">Jordan</span>
            </h1>

            <!-- Role -->
            <p class="text-2xl md:text-3xl text-base-content/80 mb-8">
                Développeur Full-Stack • Lead Tech • .NET & Angular
            </p>

            <!-- About me -->
            <div
                class="prose prose-lg mx-auto text-base-content/70 max-w-3xl mb-10">
                <p class="leading-relaxed">
                    Actuellement en poste en tant que lead tech, avec 8 ans
                    d'expérience, spécialisé dans la conception, le
                    développement et le déploiement de solutions web et mobiles.
                </p>
            </div>

            <!-- buttons CTA -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="#whatido" class="btn btn-primary btn-lg gap-2">
                    Voir mes compétences
                    <iconify-icon icon="tabler:arrow-down" class="w-5 h-5"
                    ></iconify-icon>
                </a>
                <a href="#contact" class="btn btn-outline btn-lg gap-2">
                    Me contacter
                    <iconify-icon icon="tabler:mail" class="w-5 h-5"
                    ></iconify-icon>
                </a>
            </div>

            <!-- button for scroll -->
            <div class="mt-16">
                <a
                    href="#whatido"
                    class="text-primary/80 hover:text-primary transition-colors">
                    <iconify-icon
                        icon="tabler:chevron-down"
                        class="w-10 h-5 mx-auto"></iconify-icon>
                    <p class="text-sm">Découvrir plus</p>
                </a>
            </div>
        </div>
    </div>

    <!-- Bottom wave effect -->
    <div
        class="absolute bottom-0 left-0 right-0 h-32 bg-linear-to-t from-base-200 to-transparent">
    </div>
</section>
