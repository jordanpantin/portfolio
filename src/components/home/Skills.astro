---
import { skillGroups } from "../../data/skills";
import AnimatedCard from "../shared/AnimatedCard.astro";
---

<section class="doc-section" id="skills">
    <div class="shell">
        <div class="doc-header">
            <span class="doc-no">03 — Stack</span>
            <span class="doc-meta hidden sm:block">Technologies en usage courant</span>
        </div>

        <div class="mb-12 grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
            <h2 class="section-title">
                Une base technique choisie pour durer dans un contexte
                d'entreprise<span class="accent-dot">.</span>
            </h2>

            <p class="body-copy m-0 lg:max-w-md lg:justify-self-end">
                Je privilégie les technologies qui tiennent dans la durée, qui
                s'intègrent bien dans une équipe et qui restent lisibles quand
                l'application change de périmètre, de rythme ou de charge.
            </p>
        </div>

        <div class="grid gap-10 md:grid-cols-2 md:gap-14">
            {
                skillGroups.map((group, groupIndex) => (
                    <AnimatedCard delay={groupIndex * 80}>
                        <section>
                            <div class="border-b pb-3" style="border-color: var(--ink-strong);">
                                <h3 class="row-title">{group.title}</h3>
                            </div>

                            <p class="muted-copy mt-4">{group.copy}</p>

                            <ul class="m-0 mt-5 list-none p-0">
                                {group.items.map((skill, index) => (
                                    <li
                                        class="flex items-baseline justify-between gap-4 border-b py-2.5"
                                        style="border-color: var(--hairline);">
                                        <span class="font-medium" style="color: var(--ink-strong);">
                                            {skill.name}
                                        </span>
                                        <span class="idx">{String(index + 1).padStart(2, "0")}</span>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    </AnimatedCard>
                ))
            }
        </div>
    </div>
</section>
