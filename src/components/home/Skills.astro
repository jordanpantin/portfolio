---
import { skills } from "../../data/skills";
import AnimatedCard from "../shared/AnimatedCard.astro";
---

<section class="py-24 bg-base-100" id="skills">
    <div class="container mx-auto px-6">
        <h2 class="text-5xl font-bold text-center mb-16 text-primary">
            Mes technologies
        </h2>

        <div
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">
            {
                skills.map((skill, index) => (
                    <AnimatedCard delay={index * 80}>
                        <div class="group">
                            <div class="card bg-base-200/80 backdrop-blur-sm border border-base-300 rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
                                <div class="flex flex-col items-center text-center">
                                    <div class="mb-4 bg-{skill.color}/20 rounded-2xl p-4 flex items-center justify-center">
                                        <iconify-icon
                                            icon={skill.icon}
                                            style="font-size: 56px;"
                                            class={`text-${skill.color}`}></iconify-icon>
                                    </div>
                                    <p class="text-lg font-semibold text-base-content">
                                        {skill.name}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </AnimatedCard>
                ))
            }
        </div>
    </div>
</section>
